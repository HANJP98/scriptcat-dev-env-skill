{
  "mcpServers": {
    "chrome-devtools": {
      "command": "<NODE_EXE_ABS_PATH>",
      "args": [
        "<EDGEAGENT_DIR>\\mcp\\node_modules\\chrome-devtools-mcp\\build\\src\\bin\\chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9222",
        "--no-page-id-routing",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--categoryExtensions",
        "--workspace=<YOUR_WORKSPACE_DIR>",
        "--workspace=<EDGEAGENT_DIR>"
      ],
      "env": {
        "NO_PROXY": "127.0.0.1,localhost"
      }
    }
  }
}
